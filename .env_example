GEMINI_API_KEY=your_gemini_api_key_here

# Validation uses min(4, CPU count) processes unless overridden.
# VALIDATION_WORKERS=4
VALIDATION_MAX_WAITING=96
VALIDATION_WAIT_TIMEOUT=3

# Shared async Gemini client; limits apply per API process.
GEMINI_MODEL=gemini-flash-latest
GEMINI_MAX_CONCURRENT=5
GEMINI_MAX_WAITING=20
GEMINI_QUEUE_TIMEOUT=3
GEMINI_TOTAL_TIMEOUT=30
GEMINI_ATTEMPT_TIMEOUT=10
GEMINI_RETRY_BACKOFF=0.5
# Set to your project's available request quota. 0 disables RPM pacing.
GEMINI_REQUESTS_PER_MINUTE=0

# Maximum queued application log records; full queues drop new records.
LOG_QUEUE_CAPACITY=1000
